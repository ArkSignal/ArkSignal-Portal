      "value": "airport"
     }
    ],
    "hide": 0
   },
   {
    "type": "custom",
    "name": "reading",
    "label": "Reading",
    "query": "temp_f,dew_f,hum,press_in,wind_mph,gust_mph,rain_day_in,uv,cloud_pct",
    "multi": false,
    "includeAll": false,
    "current": {
     "text": "temp_f",
     "value": "temp_f"
    },
    "options": [
     {
      "selected": true,
      "text": "temp_f",
      "value": "temp_f"
     },
     {
      "selected": false,
