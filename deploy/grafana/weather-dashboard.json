{
 "uid": "weather",
 "title": "Weather Dashboard",
 "tags": [
  "arksignal"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "type": "custom",
    "name": "sources",
    "label": "Sources",
    "query": "members,aprs,airport",
    "multi": true,
    "includeAll": false,
    "current": {
     "text": "members",
     "value": "members"
    },
    "options": [
     {
      "selected": true,
      "text": "members",
      "value": "members"
     },
     {
      "selected": false,
      "text": "aprs",
