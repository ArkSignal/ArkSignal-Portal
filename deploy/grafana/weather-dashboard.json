      "value": "wind_mph"
     },
     {
      "selected": false,
      "text": "gust_mph",
      "value": "gust_mph"
     },
     {
      "selected": false,
      "text": "rain_day_in",
      "value": "rain_day_in"
     },
     {
      "selected": false,
      "text": "uv",
      "value": "uv"
     },
     {
      "selected": false,
      "text": "cloud_pct",
      "value": "cloud_pct"
     }
