server {
    listen       ${ELEMENT_WEB_PORT};
    listen  [::]:${ELEMENT_WEB_PORT};
    server_name  localhost;

    root   /usr/share/nginx/html;
    index  index.html;

    # Element Web may be shown only inside the site's own pages
    add_header Content-Security-Policy "frame-ancestors ${FRAME_ANCESTORS}" always;
    add_header X-Content-Type-Options "nosniff" always;
    add_header Referrer-Policy "no-referrer" always;

    # no-cache for the version, config, i18n and index.html so browsers always check for a new copy of Element Web
    location = /index.html {
        add_header Cache-Control "no-cache";
        add_header Content-Security-Policy "frame-ancestors ${FRAME_ANCESTORS}" always;
        add_header X-Content-Type-Options "nosniff" always;
        add_header Referrer-Policy "no-referrer" always;
    }
    location = /version {
        add_header Cache-Control "no-cache";
    }
    location /i18n/ {
        add_header Cache-Control "no-cache";
    }
    location /usercontent/ {
        add_header Cache-Control "no-cache";
    }
    # config.json and config.hostname.json
    location /config {
        root /tmp/element-web-config;
        add_header Cache-Control "no-cache";
    }
    location /modules {
        alias /modules;
    }
    error_page   500 502 503 504  /50x.html;
}
