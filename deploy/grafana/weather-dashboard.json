 "panels": [
  {
   "id": 1,
   "type": "timeseries",
   "title": "Highest, average and lowest of the chosen stations",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "portal-json"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 24,
    "h": 10
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "portal-json"
     },
     "type": "json",
     "source": "url",
     "format": "table",
     "url": "http://adsb-portal:8430/api/weather/stats.json",
     "root_selector": "series",
     "url_options": {
      "method": "GET",
      "params": [
       {
        "key": "sources",
        "value": "${sources:csv}"
       },
       {
        "key": "metric",
        "value": "${reading}"
       },
       {
        "key": "period",
        "value": "${period}"
       },
       {
        "key": "counties",
        "value": "${counties}"
       },
       {
        "key": "cities",
        "value": "${cities}"
       },
       {
        "key": "zips",
        "value": "${zips}"
       },
       {
        "key": "stations",
        "value": "${stations}"
       },
       {
        "key": "near",
        "value": "${near}"
       }
      ]
     },
     "columns": [
      {
       "selector": "ts",
       "text": "Time",
       "type": "timestamp"
      },
      {
       "selector": "max",
       "text": "Highest",
       "type": "number"
      },
      {
       "selector": "avg",
       "text": "Average",
       "type": "number"
      },
      {
       "selector": "min",
       "text": "Lowest",
       "type": "number"
      }
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {
    "legend": {
     "displayMode": "list",
     "placement": "bottom"
    },
    "tooltip": {
     "mode": "multi"
    }
   }
  },
  {
   "id": 2,
