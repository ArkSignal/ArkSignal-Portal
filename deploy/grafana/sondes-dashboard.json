{
 "uid": "sondes",
 "title": "Radiosonde Dashboard",
 "tags": [
  "arksignal"
 ],
 "timezone": "browser",
 "schemaVersion": 39,
 "version": 1,
 "refresh": "5m",
 "time": {
  "from": "now-24h",
  "to": "now"
 },
 "editable": true,
 "templating": {
  "list": [
   {
    "type": "custom",
    "name": "kinds",
    "label": "Kinds",
    "query": "nws,amateur,other",
    "multi": true,
    "includeAll": false,
    "current": {
     "text": "nws",
     "value": "nws"
    },
    "options": [
     {
      "selected": true,
      "text": "nws",
      "value": "nws"
     },
     {
      "selected": false,
      "text": "amateur",
      "value": "amateur"
     },
     {
      "selected": false,
      "text": "other",
      "value": "other"
     }
    ],
    "hide": 0
   },
   {
    "type": "custom",
    "name": "status",
    "label": "Status",
    "query": ",aloft,landed,lost",
    "multi": false,
    "includeAll": false,
    "current": {
     "text": "",
     "value": ""
    },
    "options": [
     {
      "selected": true,
      "text": "",
      "value": ""
     },
     {
      "selected": false,
      "text": "aloft",
      "value": "aloft"
     },
     {
      "selected": false,
      "text": "landed",
      "value": "landed"
     },
     {
      "selected": false,
      "text": "lost",
      "value": "lost"
     }
    ],
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "sites",
    "label": "Launch sites (72340|72248)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "options": [
     {
      "selected": true,
      "text": "",
      "value": ""
     }
    ],
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "stations",
    "label": "Receiving stations (CALL|CALL)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "options": [
     {
      "selected": true,
      "text": "",
      "value": ""
     }
    ],
    "hide": 0
   },
   {
    "type": "textbox",
    "name": "flights",
    "label": "Flights (serial|serial)",
    "query": "",
    "current": {
     "text": "",
     "value": ""
    },
    "options": [
     {
      "selected": true,
      "text": "",
      "value": ""
     }
    ],
    "hide": 0
   }
  ]
 },
 "panels": [
  {
   "id": 1,
   "type": "barchart",
   "title": "Flights per day",
   "datasource": {
    "type": "yesoreyeram-infinity-datasource",
    "uid": "portal-json"
   },
   "gridPos": {
    "x": 0,
    "y": 0,
    "w": 12,
    "h": 8
   },
   "targets": [
    {
     "refId": "A",
     "datasource": {
      "type": "yesoreyeram-infinity-datasource",
      "uid": "portal-json"
     },
     "type": "json",
     "source": "url",
     "format": "table",
     "url": "http://adsb-portal:8430/api/sondes/stats.json",
     "root_selector": "per_day",
     "url_options": {
      "method": "GET",
      "params": [
       {
        "key": "sources",
        "value": "${kinds:csv}"
       },
       {
        "key": "sites",
        "value": "${sites}"
       },
       {
        "key": "stations",
        "value": "${stations}"
       },
       {
        "key": "flights",
        "value": "${flights}"
       },
       {
        "key": "from",
        "value": "${__from:date:YYYY-MM-DD}"
       },
       {
        "key": "to",
        "value": "${__to:date:YYYY-MM-DD}"
       },
       {
        "key": "status",
        "value": "${status}"
       }
      ]
     },
     "columns": [
      {
       "selector": "day",
       "text": "Day",
       "type": "string"
      },
      {
       "selector": "n",
       "text": "Flights",
       "type": "number"
      }
     ]
    }
   ],
   "fieldConfig": {
    "defaults": {
     "unit": "none"
    },
    "overrides": []
   },
   "options": {}
  },
